# ════════════════════════════════════════════════════════════════════
# Boxing Center — Phone Bot
# Copier ce fichier en  .env  et remplir les valeurs
# NE JAMAIS committer le fichier  .env  (contient les vraies clés)
# ════════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────
PORT=3000
# URL publique du serveur (ngrok en dev, domaine en prod)
# Utilisée pour construire les action= des webhooks Twilio
BASE_URL=https://xxxx-xxxx-xxxx.ngrok-free.app

# ── Twilio ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+33XXXXXXXXX        # Numéro Twilio voix + SMS
TWILIO_WHATSAPP_NUMBER=+14155238886     # Sandbox WhatsApp Twilio (ou votre numéro WA Business)

# ── SMS (remplace WhatsApp) ──────────────────────────────────────
SMS_GATEWAY_URL=http://prem-eu2.bot-hosting.net:21724
SMS_GATEWAY_SECRET=

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── IA conversationnelle ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxx
# GROQ_API_KEY_FALLBACK=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# USE_AI_REPLY=true

# ── Transferts (désactivés — le bot répond lui-même) ─────────────
# TRANSFER_ACCUEIL=+33XXXXXXXXX
# TRANSFER_ADMIN=+33XXXXXXXXX
# TRANSFER_COMPETITION=+33XXXXXXXXX

# ── Liens envoyés par SMS ─────────────────────────────────────────
BOXING_WEBSITE=https://boxingcenter.fr
LINK_HORAIRES=https://boxingcenter.fr
LINK_TARIFS=https://boutique.boxingcenter.fr/offres-speciales
LINK_ESSAI=https://boutique.boxingcenter.fr/seance-essai
LINK_INSCRIPTION=https://boutique.boxingcenter.fr
LINK_PLANNING=https://boxingcenter.fr
LINK_COMPETITION=https://boxingcenter.fr
LINK_GERER_ABO=https://boutique.boxingcenter.fr/gerer-abonnement
LINK_BOUTIQUE=https://boutique.boxingcenter.fr

# ── Options ───────────────────────────────────────────────────────
BOT_DRY_RUN=false    # true = aucun SMS envoyé, aucun transfert réel
DEBUG=false
BOT_VOICE=Polly.Remi-Neural   # homme français neural (Twilio). Alternative plus naturelle : Polly.Rémi-Generative
BOT_LANGUAGE=fr-FR
