# ════════════════════════════════════════════════════════════════════
# Boxing Center — Phone Bot
# Copier ce fichier en  .env  et remplir les valeurs
# NE JAMAIS committer le fichier  .env  (contient les vraies clés)
# ════════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────
PORT=3000
# URL publique du serveur (ngrok en dev, domaine en prod)
# Utilisée pour construire les action= des webhooks voix
BASE_URL=https://xxxx-xxxx-xxxx.ngrok-free.app

# ── Fournisseur voix ──────────────────────────────────────────────
# telnyx = moins cher (cible) | twilio = actuel (secours)
VOICE_PROVIDER=twilio

# ── Telnyx (voix) — https://portal.telnyx.com ─────────────────────
# TELNYX_API_KEY=KEY018...
# TELNYX_PHONE_NUMBER=+33XXXXXXXXX
# Option STT Telnyx (défaut Deepgram nova-2, compatible hints FR) :
# BOT_TRANSCRIPTION_ENGINE=Deepgram
# BOT_SPEECH_MODEL=deepgram/nova-2

# ── Twilio ────────────────────────────────────────────────────────
# Voix si VOICE_PROVIDER=twilio ; SMS interne menu 99 dans tous les cas
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+33XXXXXXXXX

# ── SMS (touche 1 du sous-menu) ───────────────────────────────────
SMS_GATEWAY_URL=http://prem-eu2.bot-hosting.net:21724
SMS_GATEWAY_SECRET=

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── IA conversationnelle ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxx
# GROQ_API_KEY_FALLBACK=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# … jusqu'à GEMINI_API_KEY_11 (rotation automatique)
# MISTRAL_API_KEY=
# USE_AI_REPLY=true
# Groq, Gemini et Mistral partent en même temps : le premier qui répond gagne.
# GROQ_TIMEOUT_MS=5000
# LLM_TIMEOUT_MS=8000

# ── Transferts (désactivés — le bot répond lui-même) ─────────────
# TRANSFER_ACCUEIL=+33XXXXXXXXX
# TRANSFER_ADMIN=+33XXXXXXXXX
# TRANSFER_COMPETITION=+33XXXXXXXXX

# ── Liens envoyés par SMS ─────────────────────────────────────────
BOXING_WEBSITE=https://boxingcenter.fr
LINK_HORAIRES=https://boxingcenter.fr
LINK_TARIFS=https://boutique.boxingcenter.fr/offres-speciales
LINK_ESSAI=https://boutique.boxingcenter.fr/seance-essai
LINK_INSCRIPTION=https://boutique.boxingcenter.fr
LINK_PLANNING=https://boxingcenter.fr
LINK_COMPETITION=https://boxingcenter.fr
LINK_GERER_ABO=https://boutique.boxingcenter.fr/gerer-abonnement
LINK_BOUTIQUE=https://boutique.boxingcenter.fr

# ── Options ───────────────────────────────────────────────────────
BOT_DRY_RUN=false    # true = aucun SMS envoyé, aucun transfert réel
DEBUG=false
BOT_VOICE=Polly.Remi-Neural   # homme français neural (Polly). Alternative : Polly.Rémi-Generative
BOT_LANGUAGE=fr-FR
BOT_SPEECH_RATE=110%          # débit par défaut
BOT_SPEECH_RATE_FAST=112%     # accueil, options 2 et 3
BOT_SPEECH_RATE_OFFERS=105%   # option 1 (plus posé)

# Anti-abus : 3 appels / 30 min → blocage 24 h (le 4e appel est refuse)
# CALL_ABUSE_MAX=3
# CALL_ABUSE_WINDOW_MS=1800000
# CALL_ABUSE_BLOCK_MS=86400000

# Liens SMS (brief coach)
LINK_BOUTIQUE=https://boutique.boxingcenter.fr/
LINK_SITE=https://www.boxingcenter.fr/