SUPABASE_SERVICE_ROLE_KEY=

# ─── IA ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_API_KEY_FALLBACK=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# USE_AI_REPLY=true

# ─── Transferts (désactivés) ────────────────────────────────────────────────
# TRANSFER_ACCUEIL=+33XXXXXXXXX
# TRANSFER_ADMIN=+33XXXXXXXXX
# TRANSFER_COMPETITION=+33XXXXXXXXX

# ─── Liens SMS ──────────────────────────────────────────────────────────────
