# Boxing Center — Phone Bot
# Bot-hosting : copier vers /home/container/.env

SERVER_PORT=20959
PORT=20959
BASE_URL=http://prem-eu5.bot-hosting.cloud:20959

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+33XXXXXXXXX

# ─── Supabase ───────────────────────────────────────────────────────────────
